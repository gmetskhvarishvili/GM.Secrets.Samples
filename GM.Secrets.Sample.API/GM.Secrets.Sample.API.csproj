<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!--
      Builds against the sibling GM.Secrets source checkout when it exists (../../GM.Secrets), so the
      sample can track unreleased changes; otherwise uses the published packages. Force either way with
      -p:UseLocalGMSecrets=true|false.

      The store packages are referenced but never called from code: AddGMSecrets() loads the one
      SECRETS_PROVIDER names at startup. Reference only the stores the app can be deployed with.
    -->
    <PropertyGroup>
        <GMSecretsSourceRoot>$(MSBuildThisFileDirectory)..\..\GM.Secrets\</GMSecretsSourceRoot>
        <UseLocalGMSecrets Condition="'$(UseLocalGMSecrets)' == '' and Exists('$(GMSecretsSourceRoot)GM.Secrets.slnx')">true</UseLocalGMSecrets>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseLocalGMSecrets)' == 'true'">
        <ProjectReference Include="$(GMSecretsSourceRoot)GM.Secrets\GM.Secrets.csproj" />
        <ProjectReference Include="$(GMSecretsSourceRoot)GM.Secrets.Doppler\GM.Secrets.Doppler.csproj" />
        <ProjectReference Include="$(GMSecretsSourceRoot)GM.Secrets.AwsSecretsManager\GM.Secrets.AwsSecretsManager.csproj" />
        <ProjectReference Include="$(GMSecretsSourceRoot)GM.Secrets.Vault\GM.Secrets.Vault.csproj" />
        <ProjectReference Include="$(GMSecretsSourceRoot)GM.Secrets.AzureKeyVault\GM.Secrets.AzureKeyVault.csproj" />
    </ItemGroup>

    <!-- The package applies this itself (buildTransitive); a project reference doesn't, so import it here. -->
    <Import Project="$(GMSecretsSourceRoot)GM.Secrets\buildTransitive\GM.Secrets.targets" Condition="'$(UseLocalGMSecrets)' == 'true'" />

    <ItemGroup Condition="'$(UseLocalGMSecrets)' != 'true'">
        <!-- builder.AddGMSecrets() and the store packages ship in GM.Secrets 2.0.0. -->
        <PackageReference Include="GM.Secrets" Version="2.0.0" />
        <PackageReference Include="GM.Secrets.Doppler" Version="2.0.0" />
        <PackageReference Include="GM.Secrets.AwsSecretsManager" Version="2.0.0" />
        <PackageReference Include="GM.Secrets.Vault" Version="2.0.0" />
        <PackageReference Include="GM.Secrets.AzureKeyVault" Version="2.0.0" />
    </ItemGroup>

</Project>
