<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GM.Secrets" Version="1.0.1" />
        <PackageReference Include="GM.Secrets.Environment" Version="1.0.1" />
        <PackageReference Include="GM.Secrets.Configuration" Version="1.0.1" />
        <!-- Optional: enables TTL caching of secret lookups (rotation on expiry). -->
        <PackageReference Include="GM.Caching" Version="1.0.0" />
    </ItemGroup>

</Project>
